# ==============================================================================
# SISTEM TIMBANG & SUSUT RPHU - ENVIRONMENT CONFIGURATION
# ==============================================================================

# Application Environment
APP_NAME="Sistem Timbang RPHU"
APP_ENV=development
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_SECRET=rphu_secure_jwt_secret_key_change_in_production_2026

# Database Connection (MySQL 8.0)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=rphu_timbang_db
DB_USERNAME=rphu_user
DB_PASSWORD=rphu_password123
DB_CHARSET=utf8mb4

# MQTT Broker (Mosquitto)
MQTT_HOST=127.0.0.1
MQTT_PORT=1883
MQTT_CLIENT_ID=rphu_backend_service
MQTT_USER=rphu_mqtt_user
MQTT_PASSWORD=rphu_mqtt_pass123
MQTT_TOPIC_PREFIX=rphu/scale

# Hardware Scale Gateway Defaults
DEFAULT_STATION_ID=STASIUN-01
DEFAULT_STATION_NAME="Timbang Penerimaan & Susut"
SCALE_CALIBRATION_FACTOR=-21.45
SCALE_STABILITY_THRESHOLD=0.15
SCALE_SAMPLE_WINDOW=15

# Standard Tolerances
MAX_ALLOWED_TRANSIT_SHRINKAGE=3.50
MAX_ALLOWED_CHILLING_SHRINKAGE=2.00
MIN_EXPECTED_CARCASS_YIELD=68.00
